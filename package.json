{
  "name": "token-calculator",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && npm run build -w frontend && npm run build -w backend",
    "start": "node scripts/dev.mjs --production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint frontend/src backend/src shared tests --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "catalog:sync": "node scripts/sync-catalog.mjs",
    "catalog:check": "tsx scripts/validate-catalog.ts",
    "assets": "node scripts/copy-tokenizers.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run catalog:check && npm run mini:check",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "news:sync": "tsx backend/src/sync-news.ts",
    "admin:reset": "tsx backend/src/reset-admin.ts",
    "mini:build": "node scripts/build-miniprogram.mjs",
    "mini:check": "npm run mini:build && node scripts/check-miniprogram.mjs",
    "mini:preview": "node scripts/mini-preview.mjs",
    "mini:test": "npm run build -w backend && node scripts/test-miniprogram.mjs"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "js-tiktoken": "1.0.21",
    "lucide-react": "0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "^0.27.3",
    "eslint": "9.39.4",
    "miniprogram-automator": "^0.12.1",
    "prettier": "3.8.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "4.0.18"
  },
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ]
}
