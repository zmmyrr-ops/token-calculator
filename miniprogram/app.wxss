page {
  background: #f4f7f8;
  color: #142a35;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}
view,
input,
textarea,
button {
  box-sizing: border-box;
}
.page {
  padding: 32rpx 28rpx 64rpx;
}
.hero {
  background: #102a36;
  color: #fff;
  border-radius: 32rpx;
  padding: 38rpx;
  margin-bottom: 28rpx;
  position: relative;
  overflow: hidden;
}
.hero .muted {
  color: #a8c9cc;
}
.brand {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 22rpx;
}
.logo {
  width: 80rpx;
  height: 80rpx;
}
.eyebrow {
  font-size: 21rpx;
  letter-spacing: 5rpx;
  color: #66dbc0;
}
.title {
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.35;
  margin: 12rpx 0 20rpx;
}
.heading {
  font-size: 33rpx;
  font-weight: 650;
  margin: 28rpx 0 18rpx;
}
.muted {
  color: #71808b;
  font-size: 25rpx;
}
.card {
  background: #fff;
  border: 1rpx solid #e4ecee;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.45;
  margin: 8rpx 0 12rpx;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}
.grow {
  flex: 1;
  min-width: 0;
}
.tag {
  color: #0a8c78;
  font-size: 23rpx;
}
.cover {
  width: 190rpx;
  height: 156rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #e5eff0;
}
.chip {
  display: inline-block;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  margin: 0 12rpx 14rpx 0;
  background: #e8efef;
  color: #52636c;
  font-size: 25rpx;
}
.chip.active {
  background: #102a36;
  color: #a4f1d8;
}
.search,
input,
textarea {
  background: #fff;
  border: 1rpx solid #dce5e8;
  border-radius: 16rpx;
  padding: 22rpx;
  width: 100%;
  margin: 16rpx 0;
  height: auto;
  min-height: 84rpx;
}
textarea {
  min-height: 260rpx;
}
.label {
  display: block;
  margin-top: 20rpx;
  font-size: 25rpx;
  color: #536872;
}
button {
  font-size: 27rpx;
  border-radius: 16rpx;
  margin: 18rpx 0;
  background: #e9f1f1;
  color: #183b45;
}
button::after {
  border: 0;
}
.primary {
  background: #0c8b77;
  color: white;
}
.danger {
  color: #b23c40;
  background: #fff0f0;
}
.link {
  color: #0a8c78;
  padding: 12rpx 0;
}
.state {
  text-align: center;
  color: #7a8890;
  padding: 36rpx 20rpx;
}
.body {
  white-space: pre-wrap;
  word-break: break-word;
  line-height: 1.85;
}
.divider {
  height: 1rpx;
  background: #edf1f2;
  margin: 24rpx 0;
}
.big {
  font-size: 52rpx;
  font-weight: 700;
  color: #0a8c78;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #ddf2ee;
  text-align: center;
  line-height: 96rpx;
  font-size: 42rpx;
  color: #137764;
}
.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}
.grid .card {
  margin: 0;
}
.tiny {
  font-size: 22rpx;
  color: #7a8890;
}
.notice {
  border-left: 5rpx solid #4bc4a5;
  padding: 18rpx 24rpx;
  background: #e9f6f1;
  margin: 20rpx 0;
  border-radius: 8rpx;
}
.thumb {
  width: 100%;
  height: 320rpx;
  border-radius: 22rpx;
  margin-bottom: 20rpx;
}
.hidden-canvas {
  position: fixed;
  left: -1000px;
  top: -1000px;
  width: 256px;
  height: 256px;
}

.page { padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
