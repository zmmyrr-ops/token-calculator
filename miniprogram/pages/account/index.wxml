<view class="page"
  ><view class="title"
    >{{user ? '管理我的账号' : mode === 'login' ? '欢迎回来。' : '开启你的 AI
    门道。'}}</view
  ><view class="muted">与网站共用账号、昵称与社区记录。</view
  ><view wx:if="{{user}}" class="card"
    ><image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" class="avatar" /><view
      wx:else
      class="avatar"
      >我</view
    ><button bindtap="chooseAvatar">从相册选择头像</button
    ><button bindtap="defaultAvatar">使用默认头像</button
    ><view class="tiny">头像自动裁为正方形，点击保存资料后上传。</view></view
  ><view class="card"
    ><block wx:if="{{!user}}"
      ><text class="label">账号</text
      ><input
        value="{{username}}"
        data-field="username"
        bindinput="field"
        maxlength="32"
        placeholder="4–32 位字母、数字或下划线" /><text class="label">密码</text
      ><input
        password
        value="{{password}}"
        data-field="password"
        bindinput="field"
        maxlength="128"
        placeholder="{{mode === 'register' ? '至少 12 位' : '请输入密码'}}" /></block
    ><block wx:if="{{user || mode === 'register'}}"
      ><text class="label">昵称</text
      ><input
        value="{{nickname}}"
        data-field="nickname"
        bindinput="field"
        maxlength="24"
        placeholder="你的公开昵称" /></block
    ><block wx:if="{{!user}}"
      ><checkbox-group bindchange="agree"
        ><label class="tiny"
          ><checkbox
            value="yes"
            checked="{{agreed}}"
          />我已阅读并同意隐私说明与社区规则</label
        ></checkbox-group
      ><view class="link" bindtap="privacy">查看隐私说明与社区规则</view></block
    ><button
      class="primary"
      bindtap="submit"
      loading="{{loading}}"
      disabled="{{loading}}"
    >
      {{user ? '保存资料' : mode === 'login' ? '登录' : '注册'}}</button
    ><button wx:if="{{!user}}" bindtap="mode">
      {{mode === 'login' ? '还没有账号？注册' : '已有账号？登录'}}
    </button></view
  ><view wx:if="{{user}}" class="card"
    ><view class="heading">修改密码</view
    ><input
      password
      placeholder="当前密码"
      value="{{oldPassword}}"
      data-field="oldPassword"
      bindinput="field"
      maxlength="128"
    /><input
      password
      placeholder="新密码，至少 12 位"
      value="{{password}}"
      data-field="password"
      bindinput="field"
      maxlength="128"
    /><button bindtap="password" disabled="{{loading}}">
      修改并退出所有设备
    </button></view
  ><view wx:if="{{error}}" class="notice">{{error}}</view
  ><canvas
    class="hidden-canvas"
    canvas-id="avatar"
    style="width: 256px; height: 256px"
/></view>
