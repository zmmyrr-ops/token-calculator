.tabs{position:fixed;bottom:0;left:0;right:0;z-index:100;background:#fff;border-top:1rpx solid #e5edee;display:flex;padding:12rpx 10rpx calc(12rpx + env(safe-area-inset-bottom));box-shadow:0 -4rpx 22rpx #102a3605}.tab{flex:1;text-align:center;color:#74838a;font-size:22rpx;display:flex;align-items:center;flex-direction:column;gap:4rpx;padding:4rpx 0}.tab.active{color:#0a8c78;font-weight:600}.tab image{width:44rpx;height:44rpx}
